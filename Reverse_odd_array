#include <iostream>
# include<limits.h>
using namespace std;

// Program to reverse an odd array

void reversearray(int arr[],int sz){
    int start = 0;
    int end = sz -1;
    while(start <=end){
        swap(arr[start],arr[end]);
        start++;
        end--;
    }
}

int main(){
    int arr[] = {1,2,3,4,5};
    int sz = 5;

    reversearray(arr,sz);
    for(int i = 0; i<5; i++){
        cout << arr[i];
    }
    cout << endl;
}
