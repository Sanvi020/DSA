#include <iostream>
# include<limits.h>
using namespace std;

// Program to print intersection of elements in 2 arrays

int main(){
    int arr1[] = {1,2,3,4,5};
    int arr2[] = {6,7,8,3,1};

    for(int i = 0; i<5; i++){
        for(int j = 0 ; j<5; j++){
            if(arr1[i] == arr2[j]){
                cout << arr1[i] << endl;
                break;
            }
        }
    }
}
