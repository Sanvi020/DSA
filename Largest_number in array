#include <iostream>
# include<limits.h>
using namespace std;

// Program to find largest number in an array

int main(){
    int num[5] = {33,-2,89,20,100};
    int largest = 0;

    for(int i = 0; i<5 ; i++){
        if(num[i] > largest){
            largest = num[i];
        }
    }
    cout << "Largest number in array is : " << largest << endl;
}
