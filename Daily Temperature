class Solution {
public:
    vector<int> dailyTemperatures(vector<int>& nums) {
        vector<int> ans(nums.size(),0);
        int n = nums.size();
        stack<int> s;

        for(int i = n-1; i>= 0; i--){
            while(s.size()>0 && nums[s.top()]<= nums[i]){
                s.pop();
            }
            if(s.empty()){
                ans[i] = 0;
            }
            else{
                ans[i] = abs(s.top()-i);
            }
            s.push(i);
        }
        return ans;
    }
};
