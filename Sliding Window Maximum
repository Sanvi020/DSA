class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        deque<int> dq;
        vector<int> ans;

        // analyze first window
        for(int i= 0; i<k; i++){
            // removing smaller elements
            while(dq.size()>0 && nums[dq.back()]<= nums[i]){
                dq.pop_back();
            }
            dq.push_back(i);
        }

        // iterating for other windows
        for(int i =k; i<nums.size(); i++){
            ans.push_back(nums[dq.front()]);
            
            // checking if the element is in the curr window
            while(dq.size()>0 && dq.front()<=i-k){
                dq.pop_front();
            }

            // removing smaller elements
            while(dq.size()>0 && nums[dq.back()]<=nums[i]){
                dq.pop_back();
            }
            dq.push_back(i);
        }
        ans.push_back(nums[dq.front()]);
        return ans;
    }
};
