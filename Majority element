class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        unordered_map<int,int> m;
        vector<int> ans;
        for(int el: nums){
            m[el]++;
        }
        for(auto val : m){      // looping a maps
            if(val.second>nums.size()/3){
                ans.push_back(val.first);
            }
        }
        return ans;
    }
};
