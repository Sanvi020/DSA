#include <iostream>
# include<limits.h>
using namespace std;

// Program to calculate sum of all numbers in an array

int main(){
    int arr[] = {1,2,3,4,5};
    int sum = 0;
    for(int i = 0; i<5; i++){
        sum += arr[i];
    }
    cout << "The sum of all the numbers in array is : " << sum << endl;
}
