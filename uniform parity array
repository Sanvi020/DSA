class Solution {
public:
    bool uniformArray(vector<int>& nums) {
        int min = INT_MAX;
        int sum = 0;
        for(int i =0; i<nums.size(); i++){
            if(nums[i]<min){
                min = nums[i];
            }
            sum += nums[i];
        }

        if(min%2==0){
            if(sum%2==0){
                return true;
            }
            else{
                return false;
            }
        }
        return true;
    }
};
