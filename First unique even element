class Solution {
public:
    int firstUniqueEven(vector<int>& nums) {
        unordered_map<int,int>m;
        queue<int> q;

        for(int i =0; i<nums.size(); i++){
            if(nums[i]%2==0){
                if(m.find(nums[i])==m.end()){
                    q.push(i);
                }
                m[nums[i]]++;

                while(!q.empty() && m[nums[q.front()]]>1){
                    q.pop();
                }
            }
        }
        return q.empty() ? -1: nums[q.front()];
    }
};
