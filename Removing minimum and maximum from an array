class Solution {
public:
    int minimumDeletions(vector<int>& nums) {
    int ans = INT_MAX;
    int l = 0;
    int r = 0;
    int count = 0;
    int idx1 = 0;
    int idx2 = 0;
    int maxe = INT_MIN;
    int mine = INT_MAX;

    if(nums.size()==1){
        return 1;
    }

    if(nums.size()==0){
        return 0;
    }

    for (int i = 0; i < nums.size(); i++)
    {
        if (nums[i] > maxe)
        {
            maxe = nums[i];
            idx1 = i;
        }
        if (nums[i] < mine)
        {
            mine = nums[i];
            idx2 = i;
        }
    }
    if(idx1<idx2){
        l= idx1;
        r = idx2;
    }
    else{
        l = idx2;
        r = idx1;
    }

    if(nums.size()>1){
    for(int i =l ; i>=0; i--){
        count++;
    }
    for(int i = r; i<nums.size();i++){
        count++;
    }
    ans = min(count,ans);

    count = 0;

    // front deletion
    for(int i =0; i<=r; i++){
        count++;
    }
    ans = min(count,ans);
    count = 0;

    // back deletion

    for(int i = nums.size()-1; i>=l; i--){
        count++;
    }
    ans = min(ans,count);
}
    return ans;
    }
};
