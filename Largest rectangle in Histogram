class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        stack<int> s;
        vector<int> l(heights.size(),0);
        vector<int> r(heights.size(),0);

        // right smaller element
        int n = heights.size();
        for(int i = n-1; i>=0; i--){
            while(s.size()>0 && heights[s.top()]>= heights[i]){
                s.pop();
            }
            if(s.empty()){
            r[i] = n;
            }
            else{
                r[i] = s.top();
            }
            s.push(i);
        }

        // Before finding left smaller we need to clear the stack
        while(!s.empty()){
            s.pop();
        }

        // Left smaller element
        for(int i =0; i<n; i++){
            while(s.size()>0 && heights[s.top()]>= heights[i]){
                s.pop();
            }
            if(s.empty()){
                l[i] = -1;
            }
            else{
                l[i] = s.top();
            }
            s.push(i);
        }
        int ans =0 ;
        // finding the area
        for(int i =0; i<n; i++){
            int width = r[i]-l[i]-1; // something similar to sliding window
            //can be used in multiple rectangle problems
            int currarea = heights[i]*width;
            ans = max(ans, currarea);
        }
        return ans;
    }
};
