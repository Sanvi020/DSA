#include <iostream>
# include<limits.h>
using namespace std;

// linear search --> To find a specific number in array and print its index

int main(){
    int num[5] = {23,4,3,2,90};    // Target = 3
    int index;

    for(int i = 0 ; i<5; i++){
        if(num[i]==3){
            index = i;
        }
    }
    cout << index;
}
