class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        int n = nums.size();
        int count = 0;

        unordered_set<int>s;
        for(int i =0; i<n; i++){
            if(s.count(nums[i])){
                continue;
            }
            s.insert(nums[i]);

            int st = i;
            int end = i;

            for(int j = i+1; j<n; j++){
                if(nums[j]==nums[i]){
                    end = j;
                }
            }
            bool special = true;
            for(int k = st; k<=end; k++){
                if(nums[k]!=nums[i]){
                    special=  false;
                    break;
                }
            }
            if(special){
                count++;
            }
        }
        return count;
    }
};
